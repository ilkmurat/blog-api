    {
      "name": "List posts by tag",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/posts?tag=qdrant&page_size=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "posts"
          ],
          "query": [
            {
              "key": "tag",
              "value": "qdrant"
            },
            {
              "key": "page_size",
              "value": "5"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 page shape', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.all.keys('items','total','page','page_size','pages'); });",
              "const d = pm.response.json();",
              "pm.test('Filtered to tag and summary-only items', () => { pm.expect(d.items.map(i => i.slug)).to.include(pm.collectionVariables.get('slug')); d.items.forEach(i => { pm.expect(i).to.have.all.keys(...['id','slug','title','excerpt','author','category','tags','published_at','reading_time','like_count']); }); });"
            ]
          }
        }
      ]
    },
