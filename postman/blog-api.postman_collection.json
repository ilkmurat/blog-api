            "v1",
            "posts"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"x\",\n  \"content\": \"x\",\n  \"category\": \"x\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create post",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "posts"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Contract Check {{$timestamp}}\",\n  \"content\": \"Vector similarity search with Qdrant embeddings.\",\n  \"category\": \"API Testing\",\n  \"tags\": [\n    \"Postman\",\n    \"Qdrant\",\n    \"postman\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const p = pm.response.json();",
              "pm.test('Post shape', () => { pm.expect(p).to.include.all.keys(...['id','slug','title','excerpt','author','category','tags','published_at','reading_time','like_count'], 'content','created_at','updated_at'); });",
              "pm.test('Category and tags normalised', () => { pm.expect(p.category.slug).to.eql('api-testing'); pm.expect(p.tags.map(t => t.slug)).to.have.members(['postman','qdrant']); });",
              "pm.collectionVariables.set('slug', p.slug);"
            ]
          }
        }
      ]
    },
